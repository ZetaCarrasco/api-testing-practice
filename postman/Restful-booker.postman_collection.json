                  "pm.test(\"Response has correct booking details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.booking.firstname).to.eql(\"John\");",
                  "    pm.expect(jsonData.booking.lastname).to.eql(\"Smith\");",
                  "    pm.expect(jsonData.booking.totalprice).to.eql(150);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"bookingid\", pm.response.json().bookingid);"
