      "item": [
        {
          "name": "Get all booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Body is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"List is not empty\", function () {",
                  "    pm.expect(pm.response.json()).to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test(\"First booking has a valid ID\", function () {",
                  "    pm.expect(pm.response.json()[0]).to.have.property(\"bookingid\");",
                  "    pm.expect(pm.response.json()[0].bookingid).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
